# Copy to .env and fill in your real details, then run:
#   python run.py download --limit 1
#
# Harvard Dataverse requires a Guestbook response before this dataset can be
# downloaded. Dataverse records one response per download request -- it is the
# data provider's record of who used their data, so use your real details.
#
# .env is gitignored and must never be committed.
# On Kaggle, set these four as Kaggle Secrets instead; real environment
# variables take precedence over this file.

DATAVERSE_GB_NAME=Your Full Name
DATAVERSE_GB_EMAIL=you@example.edu
DATAVERSE_GB_INSTITUTION=Your University
DATAVERSE_GB_POSITION=Student
